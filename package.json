{
	"name": "n8n-nodes-smtp-server-multi-user",
	"version": "0.3.0",
	"description": "SMTP Server Trigger Node for n8n with multi-user authentication and TLS",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"smtp",
		"email",
		"tls"
	],
	"license": "MIT",
	"homepage": "https://github.com/LucasStone98/n8n-nodes-smtp-server-multi-user",
	"author": {
		"name": "Alex Yevtushenko",
		"email": "a@qx.zone"
	},
	"contributors": [
		{
			"name": "LucasStone98",
			"url": "https://github.com/LucasStone98"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LucasStone98/n8n-nodes-smtp-server-multi-user.git"
	},
	"bugs": {
		"url": "https://github.com/LucasStone98/n8n-nodes-smtp-server-multi-user/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"main": "index.js",
	"scripts": {
		"build": "npx rimraf dist && tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials tests package.json --write",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"prepublishOnly": "npm run build && eslint -c .eslintrc.prepublish.js nodes credentials package.json"
	},
	"files": [
		"dist/credentials",
		"dist/nodes",
		"index.js",
		"CHANGELOG.md",
		"DEPENDENCIES.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/SmtpServerTlsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SmtpServerMultiUserTrigger/SmtpServerMultiUserTrigger.node.js"
		]
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@typescript-eslint/parser": "~8.32.0",
		"eslint": "^8.57.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"gulp": "^5.0.0",
		"jest": "^30.0.4",
		"nodemailer": "^10.2.1",
		"prettier": "^3.5.3",
		"ts-jest": "^29.4.0",
		"typescript": "^5.8.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"@types/mailparser": "^3.9.0",
		"@types/smtp-server": "^3.5.13",
		"mailparser": "^3.12.4",
		"smtp-server": "^3.21.1"
	}
}
